{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "tests",
    "src/config.ts",
    "src/runtime.ts",
    "src/fsrsAdapter.ts",
    "src/rich/types.ts",
    "src/rich/planner.ts",
    "src/rich/diagnostic.ts",
    "src/rich/store.ts",
    "src/storage.ts",
    "src/common-engine/session-orchestration.ts",
    "src/common-engine/learning-ui.ts",
    "src/common-engine/learning-ui-contract.json"
  ]
}
